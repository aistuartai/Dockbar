    "brand": "node scripts/brand.mjs"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/js-yaml": "^4.0.9",
    "typescript": "^5.6.3",
    "vite": "^6.0.7"
  }
}
