{
  "name": "dockbar",
  "version": "0.6.0",
  "description": "A persistent, fully styleable navigation bar for every Home Assistant dashboard.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "tsc --noEmit && vite build",
